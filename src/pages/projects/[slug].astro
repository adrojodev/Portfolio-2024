---
import Layout from '../../layouts/Layout.astro';
import ProductPreview from '../../components/ProductPreview.astro';
import data from '../../data/projects.json';
import { caseStudies } from '../../data/case-studies';
export function getStaticPaths() {
  const projects = data.projects.filter(project => 'caseStudy' in project && project.caseStudy);
  return projects.map((project, index) => ({ params: { slug: project.id }, props: { project, next: projects[(index + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
const story = caseStudies[project.id];
---
<Layout title={`${project.name} — Rojo`} description={project.summary}>
  <main id="main" class="page-width" tabindex="-1">
    <div class="page-intro project-intro"><a class="text-link" href="/projects/">← All projects</a><p class="eyebrow" style="margin-top: 32px;">{project.status} / {project.date}</p><h1>{project.name}</h1><p class="project-subtitle">{story.headline}</p><p>{story.intro}</p></div>
    <dl class="project-facts"><div><dt>My role</dt><dd>{project.role}</dd></div><div><dt>Platform</dt><dd>{project.platform}</dd></div><div><dt>Period</dt><dd>{project.date}</dd></div><div><dt>Context</dt><dd>{project.company}</dd></div></dl>
    <div class="project-actions">{story.actions.map((action, index) => <a class={index === 0 ? 'button' : 'text-link'} href={action.url} target="_blank" rel="noopener noreferrer">{action.label} <span aria-hidden="true">↗</span></a>)}</div>
    <figure style="margin: 0 0 24px;"><ProductPreview id={project.id} detail /><figcaption class="asset-caption">{story.caption}</figcaption></figure>
    {story.sections.map((section, index) => <section class="case-section" aria-labelledby={`section-${index}`}><div><p class="eyebrow">{section.label}</p><h2 id={`section-${index}`}>{section.title}</h2></div><div class="case-prose">{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}{section.note && <aside class="case-note"><strong>{section.note.title}</strong><p>{section.note.text}</p></aside>}</div></section>)}
    <details class="sources"><summary>Public references & credits</summary><ul>{story.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a></li>)}</ul><p class="asset-caption">Product features are described from public material. Personal contributions are based on my account of the work.</p></details>
    <div class="next-project"><a class="text-link" href="/projects/">← Project archive</a><a href={`/projects/${next.id}/`}>Next: {next.name} →</a></div>
  </main>
</Layout>
