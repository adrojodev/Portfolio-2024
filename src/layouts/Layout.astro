---
import { ViewTransitions } from 'astro:transitions';
import '@fontsource-variable/work-sans';
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../sections/Footer/index.astro';
interface Props { title: string; description?: string; image?: string; }
const { title, description = 'David Hernández (Rojo) is a software engineer and product designer in Mexico City. Explore AI creative tools, independent iOS apps, and production engineering.', image = '/og-image.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://www.adrojo.com/').href;
const socialImage = new URL(image, 'https://www.adrojo.com/').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Rojo’s red-haired avatar on a warm cream background" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rojo — Design & Engineering" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Rojo’s red-haired avatar on a warm cream background" />
    <meta name="theme-color" content="#FBF8F4" />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="bg-background text-body">
    <a class="skip-link" href="#main">Skip to content</a>
    <Navigation />
    <slot />
    <Footer />
  </body>
</html>
