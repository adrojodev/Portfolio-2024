---
import ProductPreview from './ProductPreview.astro';
import ArrowIcon from './ArrowIcon.astro';
import type data from '../data/projects.json';
interface Props { project: (typeof data.projects)[number]; }
const { project } = Astro.props;
const internal = 'caseStudy' in project && project.caseStudy;
const href = internal ? `/projects/${project.id}/` : project.url;
---
<article class="project-card">
  <a href={href} class="project-link" target={internal ? undefined : '_blank'} rel={internal ? undefined : 'noopener noreferrer'}>
    <ProductPreview id={project.id} />
    <div class="project-copy">
      <div class="project-meta"><span>{project.platform}</span><span>{project.date}</span></div>
      <h3>{project.name}<ArrowIcon size={24} class="project-arrow" /></h3>
      <p>{project.summary}</p>
      <div class="project-role">{project.role}</div>
    </div>
  </a>
</article>
