---
import data from '../../data/socials.json';
const { linkedin, github, instagram, mail } = data.socials;
const links = [{ name: 'LinkedIn', href: linkedin, icon: 'LinkedinLogo' }, { name: 'GitHub', href: github, icon: 'GithubLogo' }, { name: 'Instagram', href: instagram, icon: 'InstagramLogo' }];
---
<section id="connect" class="section connect-section">
  <h2>Something worth<br />building together?</h2>
  <a class="contact-email" href={mail}>ad_rojo@outlook.com</a>
  <div class="social-links">{links.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer"><img src={`/icons/${link.icon}.svg`} alt="" width="22" height="22" /><span>{link.name}</span></a>)}</div>
</section>
