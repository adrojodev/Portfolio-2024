---
import Card from '../../components/Card.astro';
import data from '../../data/projects.json';
const selected = data.projects.filter(project => 'caseStudy' in project && project.caseStudy);
const more = data.projects.filter(project => !('caseStudy' in project && project.caseStudy));
---
<section id="projects" class="section work-section">
  <div class="section-heading"><h2>A few things I’ve helped bring to life.</h2></div>
  <div class="featured-grid">
    {selected.map(project => <Card project={project} />)}
  </div>
  <details class="section-disclosure work-disclosure">
    <summary><span class="disclosure-closed">See all work</span><span class="disclosure-open">Hide extra projects</span></summary>
    <div id="archive" class="project-grid">{more.map(project => <Card project={project} />)}</div>
  </details>
</section>
