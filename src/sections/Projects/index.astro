---
import Card from '../../components/Card.astro';
import data from '../../data/projects.json';
const featured = data.projects.filter(project => 'featured' in project && project.featured);
const team = data.projects.filter(project => ['lummi', 'lyft-business'].includes(project.id));
---
<section id="projects" class="section work-section">
  <div class="section-heading"><h2>A few things I’ve helped bring to life.</h2><a class="text-link" href="/projects/">All projects</a></div>
  <div class="featured-grid">
    {featured.map(project => <Card project={project} />)}
    {team.map(project => <Card project={project} />)}
  </div>
</section>
